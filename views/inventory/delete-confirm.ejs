<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head") %>
<link rel="stylesheet" media="screen" href="/css/inventory.css">

<body>
    <div id="wrapper">
        <%- include("../partials/header") %>
        <%- include("../partials/navigation") %>

        <main>
            <h1><%= title %></h1>

            <%- messages() %>

            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error => { %>
                        <li><%= error.msg %></li>
                    <% }) %>
                </ul>
            <% } %>

            <form action="/inv/delete" method="post">
                <%- classificationList %>

                <label for="inv_make">Make *</label>
                <input type="text" name="inv_make" value="<%= inv_make || "" %>" readonly>

                <label for="inv_model">Model *</label>
                <input type="text" name="inv_model" value="<%= inv_model || "" %>" readonly>

                <label for="inv_price">Price *</label>
                <input type="number" name="inv_price" value="<%= inv_price || "" %>" readonly>

                <label for="inv_year">Year *</label>
                <input type="number" name="inv_year" value="<%= inv_year || "" %>" readonly>

                <button type="submit">Delete Vehicle</button>

                <input type="hidden" name="inv_id" <% if (locals.inv_id) { %>
                    value="<% locals.inv_id %>"
                <% } %>>
            </form>
            <p>Confirm Delete - The delete is permanent.</p>
        </main>

        <%- include("../partials/footer") %>
    </div>

    <script src="/js/inv-update.js"></script>
</body>
</html>