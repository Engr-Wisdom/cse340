    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" media="screen" href="/css/classification.css">
</head>

<body>
    <div id="wrapper">
        <%- include("../partials/header") %>
