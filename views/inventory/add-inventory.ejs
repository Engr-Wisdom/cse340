<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" media="screen" href="/css/inventory.css">
</head>

<body>
    <div id="wrapper">
        <%- include("../partials/header") %>
        <%- include("../partials/navigation") %>

        <main>
            <h1><%= title %></h1>

            <%- messages() %>

            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error => { %>
                        <li><%= error.msg %></li>
                    <% }) %>
                </ul>
            <% } %>

            <form action="/inv/add-inventory" method="post">
                <%- classificationList %>

                <label for="inv_make">Make *</label>
                <input type="text" name="inv_make" value="<%= inv_make || "" %>" required>

                <label for="inv_model">Model *</label>
                <input type="text" name="inv_model" value="<%= inv_model || "" %>" required>

                <label for="inv_description">Description *</label>
                <textarea name="inv_description" required><%= inv_description || "" %></textarea>

                <label for="inv_image">Image Path *</label>
                <input type="text" name="inv_image" value="<%= inv_image || "" %>">

                <label for="inv_thumbnail">Thumbnail Path *</label>
                <input type="text" name="inv_thumbnail" value="<%= inv_thumbnail || "" %>">

                <label for="inv_price">Price *</label>
                <input type="number" name="inv_price" value="<%= inv_price || "" %>" required>

                <label for="inv_year">Year *</label>
                <input type="number" name="inv_year" value="<%= inv_year || "" %>" required>

                <label for="inv_miles">Miles *</label>
                <input type="number" name="inv_miles" min="1" value="<%= inv_miles || "" %>" required>

                <label for="inv_color">Color *</label>
                <input type="text" name="inv_color" value="<%= inv_color || "" %>" required>

                <button type="submit">Add Vehicle</button>
            </form>
        </main>

        <%- include("../partials/footer") %>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>