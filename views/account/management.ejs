<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" media="screen" href="/css/account.css">
</head>

<body>
    <div id="wrapper">
        <%- include("../partials/header") %>
        <%- include("../partials/navigation") %>

        <main>
            <h1><%= title %></h1>

            <%- messages() %>

            <% if (accountData) { %>
                <h2>Welcome <%= accountData.account_firstname %></h2>
                <p><a href="/account/update/<%= accountData.account_id %>" class="btn-update">Update Account Information</a></p>

                <% if (accountData.account_type === "Admin" || accountData.account_type === "Employee") { %>
                    <h3>Inventory Management</h3>
                    <p><a href="/inv/">Manage Inventory</a></p>
                <% } %>

                <div class="account-details">
                    <p><strong>First Name:</strong> <%= accountData.account_firstname %></p>
                    <p><strong>Last Name:</strong> <%= accountData.account_lastname %></p>
                    <p><strong>Email:</strong> <%= accountData.account_email %></p>
                    <p><strong>Account Type:</strong> <%= accountData.account_type %></p>
                </div>
            <% } %>

        </main>

        <%- include("../partials/footer") %>
    </div>
    <script src="/js/script.js"></script>
</body>
</html>