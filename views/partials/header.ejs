<header id="top-header">
    <span class="siteName">
        <a href="/" title="Return to home page">New Motors</a>
    </span>
    <div id="tools">
        <% if (!locals.accountData) { %>
            <a title="Click to log in" href="/account/login">My account</a>
        <% } else { %>
            <a href="/account/logout" title="Click to logout">Logout</a>
            <a href="/account/">Welcome <%= locals.accountData.account_firstname %></a>
        <% } %>
    </div>
</header>