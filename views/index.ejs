<div class="hero-container">
    <h1>Welcome to CSE Motors!</h1>
    <div class="hero">
        <img src="/images/vehicles/delorean.jpg" alt="">
        <div class="properties">
            <h2>DMC Delorean</h2>
            <p>3 Cup holders</p>
            <p>Superman doors</p>
            <p>Fuzzy dice!</p>
            <button>Own Today</button>
        </div>
    </div>
</div>

<div class="vehicle-details">
    <div class="reviews">
        <h2>DMC Delorean Reviews</h2>

        <ul>
            <li>"So fast it's almost like travelling in time." (4/5)</li>
            <li>"Collest ride on the road." (4/5)</li>
            <li>"I'm feeling McFly!" (5/5)</li>
            <li>"The most futuristic ride of our day." (4.5/5)</li>
            <li>"80's livin and I love it!" (5/5)</li>
        </ul>
    </div>

    <div class="upgrades">
        <h2>Delorean Upgrades</h2>

        <div class="upgrade-list">
            <% const upgrades = [
                {img: "/images/upgrades/flux-cap.png", name: "Flux Capacitor"},
                {img: "/images/upgrades/flame.jpg", name: "Flame Decals"},
                {img: "/images/upgrades/bumper_sticker.jpg", name: "Bumper Sticker"},
                {img: "/images/upgrades/hub-cap.jpg", name: "Hub Caps"}
            ]; %>

            <% upgrades.forEach(upgrade => { %>
                <div class="upgrade-card">
                    <div class="card-img">
                        <img src="<%= upgrade.img %>" alt="<%= upgrade.name%>">
                    </div>
                    <p><%= upgrade.name %></p>
                </div>
            <% }) %>
        </div>
    </div>
</div>